///|
test "vector 021-paranoid" {
  let (out, stats) = clean_text(
    "\u{410} \u{1F469}\u{200D}\u{1F4BB} a\u{A0}b\u{200B} \u{202A}a\u{202C}b",
    normalize_spaces=true,
    aggressive_homoglyphs=true,
    strip_emoji_glue=true,
    strip_bidi=true,
  )
  veq_str("021-paranoid/out", out, "A \u{1F469}\u{1F4BB} a b ab")
  veq_stats(
    "021-paranoid",
    stats,
    15,
    11,
    [
      ("U+200B ZERO WIDTH SPACE (Cf)", 1),
      ("U+200D ZERO WIDTH JOINER (Cf)", 1),
      ("U+202A LEFT-TO-RIGHT EMBEDDING (Cf)", 1),
      ("U+202C POP DIRECTIONAL FORMATTING (Cf)", 1),
    ],
    [
      ("U+00A0 NO-BREAK SPACE (Zs)", 1),
      ("U+0410 CYRILLIC CAPITAL LETTER A (Lu)", 1),
    ],
  )
  let report = inspect_text(
    "\u{410} \u{1F469}\u{200D}\u{1F4BB} a\u{A0}b\u{200B} \u{202A}a\u{202C}b",
    aggressive=true,
    strip_emoji_glue=true,
  )
  assert_eq(report.length, 15, msg="021-paranoid/len")
  assert_eq(report.suspicious_total, 6, msg="021-paranoid/total")
  veq_hits("021-paranoid", report, [
    (160, "space", 1),
    (1040, "confusable", 1),
    (8203, "zwj_family", 1),
    (8205, "zwj_family", 1),
    (8234, "bidi", 1),
    (8236, "bidi", 1),
  ])
}

