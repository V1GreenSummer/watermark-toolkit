test "vector 015-variation-selectors" {
  let (out, stats) = clean_text(
    "\u{4E00}\u{FE00}\u{4E01}\u{E010}0 lone\u{FE0F}\u{E010}0 \u{1820}\u{180D}",
    normalize_spaces=true,
    aggressive_homoglyphs=false,
    strip_emoji_glue=false,
    strip_bidi=false,
  )
  veq_str(
    "015-variation-selectors/out", out, "\u{4E00}\u{FE00}\u{4E01}0 lone0 \u{1820}\u{180D}",
  )
  veq_stats(
    "015-variation-selectors",
    stats,
    16,
    13,
    [("U+E010 UNKNOWN (Co)", 2), ("U+FE0F VARIATION SELECTOR-16 (Mn)", 1)],
    [],
  )
  let report = inspect_text(
    "\u{4E00}\u{FE00}\u{4E01}\u{E010}0 lone\u{FE0F}\u{E010}0 \u{1820}\u{180D}",
    aggressive=false,
    strip_emoji_glue=false,
  )
  assert_eq(report.length, 16, msg="015-variation-selectors/len")
  assert_eq(report.suspicious_total, 3, msg="015-variation-selectors/total")
  veq_hits("015-variation-selectors", report, [
    (57360, "private_use", 2),
    (65039, "variation_selector", 1),
  ])
}

