///|
test "gumbel text-basic" {
  let report = detect_text(
    "one two three four five six seven eight nine ten", "text-key",
  )
  assert_eq(report.counted, 6, msg="text-basic/counted")
  assert_close("text-basic/stat", report.statistic, 10.009079237273431)
  assert_close("text-basic/p", report.p_value, 0.06674324433018088)
}

///|
test "gumbel text-hex" {
  let report = detect_text(
    "alpha beta gamma delta epsilon zeta eta theta", "0xA1B2C3D4E5F60718",
  )
  assert_eq(report.counted, 4, msg="text-hex/counted")
  assert_close("text-hex/stat", report.statistic, 3.8735634008519853)
  assert_close("text-hex/p", report.p_value, 0.458553344656307)
}
