    561412550132262775UL, 12767042938499230955UL, 519567229784690447UL, 15944142516581663073UL,
    13525662267039873239UL, 15581016539537454890UL, 5141546411836783046UL, 7802132808572072954UL,
    3708992293899079061UL, 8902245410218055578UL, 2084203711185152026UL, 14636122161202729031UL,
    8746019066874049336UL, 911456481658597161UL, 6920530240924764739UL, 2079291729758156843UL,
    9407347495809389605UL, 17419423619082517360UL, 5893796461477052440UL, 10166393715920785568UL,
    1661455317523533242UL, 6282603946243814307UL, 15957521121184432781UL, 17004809386376246886UL,
    14297644627104485684UL, 15592796798034075542UL, 6819700455691080334UL, 13418771622256699332UL,
    6215244317718923497UL,
  ]
  let kb = normalize_key(
    "0xc1f3b0e2f967439bee028af7eafc4fd0cb01d255ef2244c62255d80874b771a5",
  )
  let u = gumbel_uniform(gumbel_seed(kb, ids, 1, 6), ids[7])
  assert_close("ids-fuzz-7-u7", u, 0.4795958480495892)
}

