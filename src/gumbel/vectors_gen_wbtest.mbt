test "gumbel ids-greedy-u4" {
  let ids = [
    900UL, 901UL, 902UL, 903UL, 4UL, 768UL, 525UL, 646UL, 536UL, 266UL, 740UL, 285UL,
    175UL, 244UL, 969UL, 761UL, 952UL, 163UL, 783UL, 797UL, 678UL, 295UL, 365UL,
    797UL, 387UL, 9UL, 53UL, 350UL,
  ]
  let kb = normalize_key("greedy-key")
  let u = gumbel_uniform(gumbel_seed(kb, ids, 0, 4), ids[4])
  assert_close("ids-greedy-u4", u, 0.001084202346890988)
}

