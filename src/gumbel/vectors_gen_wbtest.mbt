///|
test "gumbel ids-greedy" {
  let report = detect_token_ids(
    [
      900UL, 901UL, 902UL, 903UL, 4UL, 768UL, 525UL, 646UL, 536UL, 266UL, 740UL,
      285UL, 175UL, 244UL, 969UL, 761UL, 952UL, 163UL, 783UL, 797UL, 678UL, 295UL,
      365UL, 797UL, 387UL, 9UL, 53UL, 350UL,
    ],
    "greedy-key",
    window=4,
    threshold=0.000001,
    mask_repeated=true,
  )
  assert_eq(report.counted, 24, msg="ids-greedy/counted")
  assert_eq(report.tokens_total, 28, msg="ids-greedy/total")
  assert_eq(report.skipped_repeated, 0, msg="ids-greedy/skrep")
  assert_eq(report.skipped_no_context, 4, msg="ids-greedy/skctx")
  assert_close("ids-greedy/stat", report.statistic, 0.025116180051692322)
  assert_close("ids-greedy/p", report.p_value, 0.9999999999999998)
  assert_close(
    "ids-greedy/score",
    report.score,
    0.00000000000000009643274665532872,
  )
  assert_eq(report.is_watermarked, false, msg="ids-greedy/flag")
}

