// Generated by tools/gen_rewrite_vectors.py -- DO NOT EDIT BY HAND.

///|
fn close(a : Double, b : Double) -> Bool {
  let diff = if a > b { a - b } else { b - a }
  let mag = if a > b { a } else { b }
  diff <= mag * 0.000000001 + 0.000000000000001
}

///|
test "divergence same text" {
  let got = lexical_divergence("the quick brown fox", "the quick brown fox")
  assert_true(close(got, 0.0), msg="same text")
}

///|
test "divergence no tokens" {
  let got = lexical_divergence("...", "!!!")
  assert_true(close(got, 0.0), msg="no tokens")
}

///|
test "divergence one side empty" {
  let got = lexical_divergence("hello world", "")
  assert_true(close(got, 1.0), msg="one side empty")
}

///|
test "divergence synonym swap" {
  let got = lexical_divergence(
    "the quick brown fox jumps", "a swift tan fox leaps",
  )
  assert_true(close(got, 1.0), msg="synonym swap")
}

///|
test "divergence reordered" {
  let got = lexical_divergence(
    "alpha beta gamma delta", "delta gamma beta alpha",
  )
  assert_true(close(got, 1.0), msg="reordered")
}

///|
test "divergence disjoint" {
  let got = lexical_divergence("one two three four", "five six seven eight")
  assert_true(close(got, 1.0), msg="disjoint")
}

///|
test "divergence single token" {
  let got = lexical_divergence("hello", "hello")
  assert_true(close(got, 0.0), msg="single token")
}

///|
test "divergence cjk mixed" {
  let got = lexical_divergence(
    "\u{4E2D}\u{6587} text with words 123", "\u{4E2D}\u{6587} other words 456",
  )
  assert_true(close(got, 1.0), msg="cjk mixed")
}

///|
test "divergence digit change" {
  let got = lexical_divergence("version 1.2.3 is out", "version 1.2.4 is out")
  assert_true(close(got, 0.5714285714285714), msg="digit change")
}

///|
test "selection pick diverged" {
  let cands : Array[String] = [
    "the quick brown fox", "a swift tan fox leaps", "the quick brown fox",
  ]
  let (idx, scores) = select_candidate("the quick brown fox", cands)
  assert_eq(idx, 1, msg="pick diverged/idx")
  assert_eq(scores.length(), 3, msg="pick diverged/nscores")
  let want_scores : Array[Double] = [0.0, 1.0, 0.0]
  for i = 0; i < scores.length(); i = i + 1 {
    assert_true(
      close(scores[i], want_scores[i]),
      msg="pick diverged/s" + i.to_string(),
    )
  }
}

///|
test "selection length guard" {
  let cands : Array[String] = [
    "totally different wording everywhere indeed", "short text here",
  ]
  let (idx, scores) = select_candidate("short text here", cands)
  assert_eq(idx, 0, msg="length guard/idx")
  assert_eq(scores.length(), 2, msg="length guard/nscores")
  let want_scores : Array[Double] = [0.85, 0.0]
  for i = 0; i < scores.length(); i = i + 1 {
    assert_true(
      close(scores[i], want_scores[i]),
      msg="length guard/s" + i.to_string(),
    )
  }
}
